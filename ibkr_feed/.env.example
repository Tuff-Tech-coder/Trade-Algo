# ─── IBKR Live Algo Feed — Environment Variables ─────────────────────────────
# Copy this file to ibkr_feed/.env and fill in your values.
# This file is safe to commit. The real .env is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Signal runner ─────────────────────────────────────────────────────────────
# URL of the running signal_runner.py instance.
SIGNAL_RUNNER_URL=http://localhost:8001

# ── Authentication ────────────────────────────────────────────────────────────
# Must match TV_WEBHOOK_SECRET in shared/.env (or Windows environment variables).
TV_WEBHOOK_SECRET=

# ── TWS / IB Gateway connection ───────────────────────────────────────────────
TWS_HOST=127.0.0.1

# Port (IBKR defaults):
#   7496 = TWS live account
#   7497 = TWS paper trading account
#   4001 = IB Gateway live account
#   4002 = IB Gateway paper trading account
# The default below is the PAPER port — change to 7496 only when going live.
TWS_PORT=7497

# Must be unique per program connected to TWS. The bar feed uses 1; the order
# executor (in the risk server) uses 2 by default — keep them different.
TWS_CLIENT_ID=1
