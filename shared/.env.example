# ─── IBKR Live Algo — Environment Variables ──────────────────────────────────
# Copy this file to shared/.env and fill in your real values.
# shared/.env is listed in .gitignore and must NEVER be committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server authentication keys ────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"

# Protects signal submission and authenticated read endpoints.
# Signal generators include this as the X-Api-Key header on every POST.
RISK_SERVER_API_KEY=

# Independent generated key for /set_state and /reset_day. Never share it with generators.
RISK_ADMIN_API_KEY=

# Protects the signal runner bar-ingestion endpoint (/tv-bar/...).
# ibkr_feed.py sends this in the Authorization: Bearer header on every bar POST.
TV_WEBHOOK_SECRET=

# ── Order-routing webhook URLs (TradersPost → your broker account) ─────────────
# Add one line per strategy you create, matching the strategy_id exactly.
# Get each URL from: TradersPost → Strategies → [Strategy] → Subscriptions → Webhook URL
# Format: TP_WEBHOOK_<STRATEGY_ID>=https://traderspost.io/trading/webhook/...
#
# Example:
# TP_WEBHOOK_MY_STRATEGY_NAME=https://traderspost.io/trading/webhook/PASTE_HERE
#

# ── TWS / IB Gateway connection (used by the order executor) ───────────────────
# When order_router=ibkr (account_config.yaml), the risk server places orders
# through IBKR and needs these. They point at the SAME TWS the bar feed uses,
# but the executor connects with its own client id so both can run at once.
#
# Port (IBKR defaults): 7496=TWS live, 7497=TWS paper, 4001=Gateway live, 4002=Gateway paper.
# The default below is the PAPER port — change to 7496 only when going live.
# (PAPER mode will refuse to connect to a live port as a safety guard.)
TWS_HOST=127.0.0.1
TWS_PORT=7497
TWS_EXEC_CLIENT_ID=2

# Required if TWS manages more than one account. Keep the real ID private.
IBKR_ACCOUNT_ID=
